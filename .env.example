# Connection string ke Postgres untuk server (wajib)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://dev:dev@localhost:5432/booking_events

# Connection string ke Postgres database test (hanya untuk integration test)
# Jalankan: docker-compose up -d postgres_test
TEST_DATABASE_URL=postgres://dev:dev@localhost:5433/booking_events_test

# Secret key untuk signing QR code tiket (modul check-in, PRD-06)
# Ganti dengan random string panjang di production!
QR_SECRET_KEY=dev-qr-secret-key-change-in-production

# Secret key untuk signing queue token (modul waiting room, PRD-08)
# Ganti dengan random string panjang di production!
QUEUE_SECRET_KEY=dev-queue-secret-key-change-in-production

# Redis URL untuk waiting room queue (modul PRD-08)
REDIS_URL=redis://localhost:6379
