# Connection string ke Postgres untuk server (wajib)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://dev:dev@localhost:5432/booking_events

# Connection string ke Postgres database test (hanya untuk integration test)
# Jalankan: docker-compose up -d postgres_test
TEST_DATABASE_URL=postgres://dev:dev@localhost:5433/booking_events_test

# Secret key untuk signing JWT token auth (modul auth, TDD-02)
# Ganti dengan random string panjang di production!
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# Secret key untuk signing QR code tiket (modul check-in, PRD-06)
# Ganti dengan random string panjang di production!
QR_SECRET_KEY=dev-qr-secret-key-change-in-production

# Secret key untuk signing queue token (modul waiting room, PRD-08)
# Ganti dengan random string panjang di production!
QUEUE_SECRET_KEY=dev-queue-secret-key-change-in-production

# Redis URL untuk waiting room queue (modul PRD-08)
REDIS_URL=redis://localhost:6379

# Xendit payment gateway (modul orders, PRD-04)
# Gunakan secret key sandbox dari dashboard.xendit.co (format: xnd_development_...)
XENDIT_SECRET_KEY=xnd_development_your_key_here

# Callback token Xendit — diset di Xendit dashboard > Settings > Callbacks
# Dipakai untuk verifikasi webhook dari Xendit
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token_here

# MinIO object storage untuk upload gambar event
# Jalankan: docker-compose up -d minio
# Web console: http://localhost:9001 (user: minioadmin, pass: minioadmin123)
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=event-images
MINIO_PUBLIC_URL=http://localhost:9002
MINIO_USE_SSL=false
